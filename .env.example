# Copy the two values below into your hosting platform's environment
# variables UI (Render: Environment tab; Railway: Variables tab) — never
# into a committed file. This file documents the names only, no real values.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Timeweb Cloud Postgres (Moscow region) — the only thing that ever stores
# an agent's phone number (152-ФЗ data localization), separate from
# Supabase above, which holds everything else (listing content: photos,
# description, price...). See lib/timeweb.js and
# timeweb/migrations/0001_init.sql. Until TIMEWEB_DB_HOST is set, every
# phone/whitelist/credits check below falls back to its pre-Timeweb
# Supabase-only behavior — nothing about deploying this code changes
# production until these are actually filled in.
TIMEWEB_DB_HOST=
TIMEWEB_DB_PORT=5432
TIMEWEB_DB_NAME=
TIMEWEB_DB_USER=
TIMEWEB_DB_PASSWORD=
# Set to "false" only if your Timeweb instance is reachable without SSL
# (unlikely for a managed cloud DB) — defaults to requiring it.
TIMEWEB_DB_SSL=true

# Optional — powers the static map image on the Location slide of exported
# PDFs (the live interactive map is a Yandex Maps iframe, which can't be
# rasterized by html2canvas). Without any of these, PDF export falls back
# to a text-only Location slide.
#
# YANDEX_STATIC_MAPS_API_KEY: matches the live map's provider, so the PDF
# looks the same as the on-screen presentation. Create a key at
# https://developer.tech.yandex.ru/ (Static API, free tier). Wins over
# both keys below if set.
#
# GEOAPIFY_API_KEY: no billing card needed, just a free account at
# https://www.geoapify.com/. Used only if YANDEX_STATIC_MAPS_API_KEY
# above is unset.
#
# GOOGLE_MAPS_API_KEY: legacy fallback, only used if neither key above is
# set. Google requires a billing card on file even to stay within the
# free quota. Create a key in Google Cloud Console with the "Maps Static
# API" enabled; no HTTP-referrer restriction is needed since it's only
# ever called from this server, never from the browser.
YANDEX_STATIC_MAPS_API_KEY=
GEOAPIFY_API_KEY=
GOOGLE_MAPS_API_KEY=

# Required for real payments on /pricing (payform.ru / Prodamus). Get this
# from the payform cabinet at https://proffbroker.payform.ru — Настройки →
# Секретный ключ — and in that same cabinet set the notification URL to
# https://<your-domain>/api/prodamus-webhook, or paid orders will never
# credit the agent's account. Without this key, /api/pricing/pay returns
# 501 and /pricing can't take payments at all.
PRODAMUS_SECRET_KEY=
